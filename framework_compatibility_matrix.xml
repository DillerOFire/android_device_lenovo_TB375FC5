<?xml version="1.0" encoding="UTF-8"?>
<!--
    Device framework compatibility matrix for TB375FC.

    Declares every vendor-private HAL in vendor.img as optional="true"
    so the framework<->vendor VINTF check passes without us having to gut
    the vendor manifest. AOSP base FCM matrix gets merged on top,
    contributing the standard android.hardware.* required entries.

    The AOSP HAL entries (android.hardware.radio.*) add non-default
    instance names (imsSlot1, se1) that vendor declares on top of the
    AOSP-declared /default instance.

    Wired via DEVICE_FRAMEWORK_COMPATIBILITY_MATRIX_FILE in BoardConfig.mk.
    Without this file the OTA package builder raises INCOMPATIBLE because
    vendor manifest has 77 HAL instances the framework matrix doesn't
    know about.
-->
<compatibility-matrix version="1.0" type="framework">
    <hal format="aidl" optional="true">
        <name>android.hardware.radio.modem</name>
        <version>2</version>
        <interface>
            <name>IRadioModem</name>
            <instance>imsSlot1</instance>
            <instance>se1</instance>
        </interface>
    </hal>
