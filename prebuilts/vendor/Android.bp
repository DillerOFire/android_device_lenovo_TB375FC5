//
// Pixel Google AIDL/stats helper libs needed at runtime by the stock Lenovo
// prebuilt android.hardware.thermal-service.mediatek.
//
// The MTK source thermal HAL had `pixel-power-ext-V1-ndk` and `pixelatoms-cpp`
// in its shared_libs, so Soong built them, but never emitted an install rule
// (no PRODUCT_PACKAGES pull for soong-only AIDL/cc modules -> linker error at
// boot: IThermal/default never registers -> SystemServer hangs -> bootloop).
//
// Why these prebuilts live in the DEVICE tree and not vendor/lenovo:
// vendor/lenovo/TB375FC/Android.bp + TB375FC-vendor.mk are auto-generated by
// tools/gen_vendor_mk.py / extract-utils; putting the cc_prebuilt here would
// be wiped on the next regen. The device tree is hand-maintained (same pattern
// as prebuilts/framework/mediatek-common.jar and the .ko modules). The .so
// files are the android_vendor_arm64_armv8-a_shared outputs copied out of
// out/soong/.intermediates/... after a build.
//
// These are pulled in through PRODUCT_PACKAGES (landed in device.mk): they are
// real device-tree prebuilt modules, so unlike the soong-only AIDL/cc modules
// they are visible to kati's PRODUCT_PACKAGES check.
cc_prebuilt_library_shared {
    name: "pixel-power-ext-V1-ndk",
    owner: "lenovo",
    srcs: ["lib64/pixel-power-ext-V1-ndk.so"],
    shared_libs: [
        "libbinder_ndk",
    ],
    vendor: true,
    check_elf_files: false,
}

cc_prebuilt_library_shared {
    name: "pixelatoms-cpp",
    owner: "lenovo",
    srcs: ["lib64/pixelatoms-cpp.so"],
    vendor: true,
    check_elf_files: false,
}
