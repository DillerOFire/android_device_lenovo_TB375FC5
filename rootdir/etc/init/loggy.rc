# Persist early Android boot logs on the metadata partition.
# The files are intentionally separate so recovery can inspect them after a
# failed boot without relying on pstore or a live Android userspace.
on post-fs
    # logcat runs in its own SELinux domain; init prepares DAC access first.
    chmod 0755 /metadata
    rm /metadata/boot_log_full.txt
    rm /metadata/boot_log_full.txt.1
    rm /metadata/boot_log_full.txt.2
    rm /metadata/boot_log_full.txt.3
    rm /metadata/boot_log_full.txt.4
    rm /metadata/boot_log_crash.txt
    rm /metadata/boot_log_kernel.txt
    rm /metadata/boot_log_avc.txt
    start boot_log_full
    start boot_log_crash
    start boot_log_kernel
    start boot_log_avc

# Keep a rotating all-buffer history past boot completion for post-setup
# diagnostics (especially Wi-Fi), bounded to 5 × 4 MiB on /metadata.
service boot_log_full /system/bin/logcat -b all -D -r 4096 -n 4 -f /metadata/boot_log_full.txt
    class main
    user root
    group root system
    seclabel u:r:tb375fc_bootlog:s0
    disabled
    oneshot

service boot_log_crash /system/bin/logcat -b crash -D -f /metadata/boot_log_crash.txt
    class main
    user root
    group root system
    seclabel u:r:tb375fc_bootlog:s0
    disabled
    oneshot

service boot_log_kernel /system/bin/logcat -b kernel -D -f /metadata/boot_log_kernel.txt
    class main
    user root
    group root system
    seclabel u:r:tb375fc_bootlog:s0
    disabled
    oneshot

service boot_log_avc /system/bin/logcat -e avc -f /metadata/boot_log_avc.txt
    class main
    user root
    group root system
    seclabel u:r:tb375fc_bootlog:s0
    disabled
    oneshot

on property:sys.boot_completed=1
    # Keep boot_log_full alive as bounded rotating post-boot evidence. The
    # other three streams are boot-failure captures and stop as before.
    stop boot_log_crash
    stop boot_log_kernel
    stop boot_log_avc

on boot
    # Make the persisted boot logs world-readable so recovery's non-root ADB
    # (which has shell->metadata_file read) can inspect them after a soft-brick.
    chmod 0644 /metadata/boot_log_full.txt
    chmod 0644 /metadata/boot_log_crash.txt
    chmod 0644 /metadata/boot_log_kernel.txt
    chmod 0644 /metadata/boot_log_avc.txt
