# Locale-to-timezone auto-mapping.
#
# Setup Wizard sets persist.sys.locale on region pick. AOSP wifi-only-tablet
# OOBE has no manual timezone picker, and LocationTimeZoneProvider isn't
# installed (no telephony, no GMS), so without this the device sits at
# Pacific/Midway forever.
#
# Each trigger fires when persist.sys.locale changes to a known value and
# sets the matching default timezone. AlarmManagerService picks up
# persist.sys.timezone at next boot; the live property listener applies it
# immediately for most consumers. User can still override in Settings ->
# System -> Date & Time -> Time zone.
#
# Format: persist.sys.locale uses BCP 47 (hyphen, e.g. en-GB). Bare-language
# locales (e.g. "en") are not mapped because country is required.

# English-speaking
on property:persist.sys.locale=en-GB
    setprop persist.sys.timezone Europe/London

on property:persist.sys.locale=en-IE
    setprop persist.sys.timezone Europe/Dublin

on property:persist.sys.locale=en-US
    setprop persist.sys.timezone America/New_York

on property:persist.sys.locale=en-CA
    setprop persist.sys.timezone America/Toronto

on property:persist.sys.locale=en-AU
    setprop persist.sys.timezone Australia/Sydney

on property:persist.sys.locale=en-NZ
    setprop persist.sys.timezone Pacific/Auckland

on property:persist.sys.locale=en-IN
    setprop persist.sys.timezone Asia/Kolkata

on property:persist.sys.locale=en-ZA
    setprop persist.sys.timezone Africa/Johannesburg

on property:persist.sys.locale=en-SG
    setprop persist.sys.timezone Asia/Singapore

on property:persist.sys.locale=en-PH
    setprop persist.sys.timezone Asia/Manila

