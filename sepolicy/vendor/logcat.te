# Dedicated early-boot logger domain. The platform logpersist domain is
# intentionally prohibited from writing files, including custom file types, so
# we use our own coredomain (mirroring logpersist.coredomain placement).
type tb375fc_bootlog, domain, coredomain;
type tb375fc_boot_log_file, file_type;

# Do NOT domain_auto_trans(init, logcat_exec, ...): platform init.te already has
# domain_auto_trans(init, logcat_exec, logpersist). Two type_transition results
# for the same key fail binary policy creation on PixelOS A17 (works to compile
# on some trees until the vendor CIL merge is strict).
#
# loggy.rc sets seclabel u:r:tb375fc_bootlog:s0 on each service — that is an
# explicit setexeccon path. domain_trans allows the transition without adding
# a second automatic type_transition.
domain_trans(init, logcat_exec, tb375fc_bootlog);

allow tb375fc_bootlog metadata_file:dir {
    getattr
    open
    read
    search
    write
    add_name
    remove_name
};
# Files created in /metadata take the dedicated label so this domain may write them.
type_transition tb375fc_bootlog metadata_file:file tb375fc_boot_log_file;
allow tb375fc_bootlog tb375fc_boot_log_file:file {
    create
    getattr
    open
    write
    append
    setattr
};

# logcat needs logd access or no files are ever written (empty /metadata).
control_logd(tb375fc_bootlog)
unix_socket_connect(tb375fc_bootlog, logdr, logd)
get_prop(tb375fc_bootlog, logd_prop)
