// Device recovery extension for Lenovo TB375FC.
// Provides make_device() + a Device subclass that adds a "Mount metadata"
// action to the Advanced recovery menu.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_library_static {
    name: "librecovery_ui_tb375fc",
    recovery_available: true,

    cflags: [
        "-Wall",
        "-Wextra",
    ],

    srcs: [
        "recovery_ui.cpp",
    ],

    shared_libs: [
        "libbase",
        "librecovery_ui",
    ],
}
